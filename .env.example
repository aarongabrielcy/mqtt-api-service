# Copiar a ../config/mqtt-api-service/mqtt-api-service.env y completar con
# valores reales. NUNCA commitear ese archivo ni certificados reales.
#
# Este es el contrato de configuración completo de mqtt-api-service:
# el servicio ya no lee config.yaml, todo llega por variables de entorno
# (ver internal/infrastructure/config/config.go).

# App
APP_ENV=local
LOG_LEVEL=info

# LG API (LG_CLIENT_ID identifica la app/tenant, usado para construir los
# topics app/clients/<id>/{push|inbox}; LG_API_CLIENT_ID es el client id
# usado en los headers de la LG API — no necesariamente el mismo valor)
LG_CLIENT_ID=your_lg_client_id
LG_API_BASE_URL=https://api-aic.lgthinq.com
LG_API_KEY=your_lg_api_key
LG_ACCESS_TOKEN=your_lg_access_token
LG_API_CLIENT_ID=your_lg_api_client_id
COUNTRY_CODE=MX
LANGUAGE_CODE=es-MX
SERVICE_PHASE=OP

# LG MQTT (broker LG en AWS IoT). LG_MQTT_CLIENT_ID es el client id de la
# sesión MQTT/AWS IoT — debe ser único por conexión, distinto de LG_CLIENT_ID.
LG_MQTT_ENDPOINT=mqtts://your-endpoint.iot.us-west-2.amazonaws.com:8883
LG_MQTT_CLIENT_ID=your_lg_mqtt_client_id
LG_MQTT_CA_CERT_PATH=/app/certs/AmazonRootCA1.pem
LG_MQTT_CLIENT_CERT_PATH=/app/certs/lg-client.crt
LG_MQTT_CLIENT_KEY_PATH=/app/certs/lg-client.key

# Polling normal de estado LG (FASE LG-CMD-2H). Antes hardcodeado a 2
# minutos en cmd/api/main.go — ahora configurable, default 30s: cada ciclo
# hace GET /devices/:id/state para todos los dispositivos y publica
# telemetry event=0 (EventCodeTracking), independiente de los eventos
# inmediatos que ya llegan por push MQTT de LG.
LG_STATE_POLL_INTERVAL_SECONDS=30
# Cada cuánto se revalida la suscripción push/event LG (antes hardcodeado a
# 30 minutos, ahora configurable con el mismo default).
LG_EVENT_SUBSCRIPTION_MONITOR_INTERVAL_SECONDS=1800

# MongoDB (infraestructura compartida de saas-system-iot: mongo:27017)
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=mqtt-api-service
MONGO_COLLECTION_NAME=raw_lg_messages

# Redis (infraestructura compartida de saas-system-iot: redis:6379)
REDIS_ADDR=redis:6379

# Tracking Platform — gRPC de ingestion-service (NO cambiar el contrato)
TRACKING_PLATFORM_GRPC_ADDRESS=ingestion-service:50051

# Timeout/retry por request de IngestRaw (FASE LG-1B). Pensados para
# tolerar que ingestion-service tarde en resolver por DNS Docker o en estar
# listo durante el arranque. Todas opcionales, con default seguro si se
# omiten u contienen un valor no numérico.
TRACKING_GRPC_REQUEST_TIMEOUT_SECONDS=10
TRACKING_GRPC_MAX_ATTEMPTS=3
TRACKING_GRPC_RETRY_INITIAL_BACKOFF_MS=1000
TRACKING_GRPC_RETRY_MAX_BACKOFF_MS=4000

# Kafka — bridge oficial de comandos de la plataforma (FASE LG-CMD-1/2).
# KAFKA_BROKERS admite lista separada por coma ("kafka:9092,kafka2:9092").
# Los topics deben coincidir con los que ya usa tracking-platform/
# mqtt-adapter-service (no son configurables por servicio, son el contrato
# compartido de la plataforma).
KAFKA_BROKERS=kafka:9092
KAFKA_COMMAND_TOPIC=device.command.requested
KAFKA_COMMAND_CONSUMER_GROUP=mqtt-api-service-lg-commands
KAFKA_COMMAND_SENT_TOPIC=device.command.sent
KAFKA_COMMAND_PUBLISH_FAILED_TOPIC=device.command.publish_failed

# Comandos LG por Kafka con ACKNOWLEDGED por confirmación de estado. Si
# LG_COMMANDS_ENABLED=false, el consumer de Kafka no arranca (el servicio
# sigue funcionando igual que antes de esta fase, solo telemetría).
LG_COMMANDS_ENABLED=true
# FASE LG-CMD-2H: subido de 60s a 90s — con LG_STATE_POLL_INTERVAL_SECONDS
# en 30s, 90s da margen para ~2-3 ciclos de polling normal más margen de
# red/procesamiento, en vez de quedar al filo de un solo ciclo.
LG_COMMAND_ACK_TIMEOUT_SECONDS=90
LG_COMMAND_ACK_SWEEP_SECONDS=5
LG_COMMAND_SEEN_TTL_SECONDS=600
LG_COMMAND_TEMPERATURE_MIN_C=16
LG_COMMAND_TEMPERATURE_MAX_C=30
# Espera antes de refrescar estado puntualmente tras un comando exitoso o
# ambiguo (2211) — LG puede tardar un instante en reflejar el cambio físico
# en su propio estado consultable (FASE LG-CMD-2H).
LG_COMMAND_POST_REFRESH_DELAY_MS=1000

# LG_DEBUG_STATE_LOGS (FASE LG-CMD-2E): con true, activa logs de diagnóstico
# verbosos (JSON raw de estado LG, presencia del campo Oscillation, payload
# normalizado antes de gRPC, expected-vs-actual en TryConfirm). Nunca
# incluye headers/tokens/certs. Dejar en false salvo diagnóstico puntual.
LG_DEBUG_STATE_LOGS=false
